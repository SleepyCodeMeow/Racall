!macro RacallTextVariables
  Var RacallText_intro
  Var RacallText_language
  Var RacallText_search
  Var RacallText_empty
  Var RacallText_choose
  Var RacallText_folder
  Var RacallText_required
  Var RacallText_available
  Var RacallText_unavailable
  Var RacallText_spaceError
  Var RacallText_folderTitle
  Var RacallText_setup
  Var RacallText_install
  Var RacallText_cancel
  Var RacallText_seedError
!macroend
!macro RacallLoadText
  ${If} $LANGUAGE == 1033
    StrCpy $RacallText_intro "Your sources, connected notes and AI research in one place."
    StrCpy $RacallText_language "Choose your installation language"
    StrCpy $RacallText_search "Search languages…"
    StrCpy $RacallText_empty "No matching languages"
    StrCpy $RacallText_choose "Select a language from the list."
    StrCpy $RacallText_folder "Change folder…"
    StrCpy $RacallText_required "Required:"
    StrCpy $RacallText_available "Available:"
    StrCpy $RacallText_unavailable "Free space unavailable"
    StrCpy $RacallText_spaceError "There is not enough free space on the selected drive."
    StrCpy $RacallText_folderTitle "Choose the parent folder for Racall"
    StrCpy $RacallText_setup "Racall Setup"
    StrCpy $RacallText_install "Install"
    StrCpy $RacallText_cancel "Cancel"
    StrCpy $RacallText_seedError "Could not save the installation language. Check access to the app folder."
  ${EndIf}
  ${If} $LANGUAGE == 1049
    StrCpy $RacallText_intro "Источники, связанные заметки и исследования с ИИ в одном месте."
    StrCpy $RacallText_language "Выберите язык установки"
    StrCpy $RacallText_search "Найти язык…"
    StrCpy $RacallText_empty "Язык не найден"
    StrCpy $RacallText_choose "Выберите язык из списка."
    StrCpy $RacallText_folder "Изменить папку…"
    StrCpy $RacallText_required "Требуется:"
    StrCpy $RacallText_available "Свободно:"
    StrCpy $RacallText_unavailable "Свободное место недоступно"
    StrCpy $RacallText_spaceError "На выбранном диске недостаточно свободного места."
    StrCpy $RacallText_folderTitle "Выберите папку для установки Racall"
    StrCpy $RacallText_setup "Установка Racall"
    StrCpy $RacallText_install "Установить"
    StrCpy $RacallText_cancel "Отмена"
    StrCpy $RacallText_seedError "Не удалось сохранить язык установки. Проверьте доступ к папке приложения."
  ${EndIf}
!macroend
