; Generated by scripts/build_installer_catalog.py. Edit catalog.json.
!macro RacallEachLanguage ACTION
  !insertmacro ${ACTION} "en" "1033" "English" "English en английский"
  !insertmacro ${ACTION} "ru" "1049" "Русский" "Русский ru Russian"
!macroend
